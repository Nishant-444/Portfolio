---
import Page from '../layouts/Page.astro';
import Credentials from '../components/sections/Credentials.astro';
import { CERTIFICATIONS } from '../data/credentials';
import { SITE } from '../config/site';

const personId = `${SITE.url}/#person`;

const credentialNodes = CERTIFICATIONS.map((cert) => ({
	'@type': 'EducationalOccupationalCredential',
	name: cert.name,
	credentialCategory: 'certificate',
	dateCreated: cert.issuedISO,
	...(cert.expiresISO ? { expires: cert.expiresISO } : {}),
	...(cert.credentialId ? { identifier: cert.credentialId } : {}),
	...(cert.url ? { url: cert.url } : {}),
	recognizedBy: { '@type': 'Organization', name: cert.issuer },
	about: { '@id': personId },
}));
---

<Page
	title="Credentials"
	description="Certifications and achievements — Microsoft GitHub Foundations, freeCodeCamp, HackerRank, and twice recommended by the Indian Air Force via SSB."
	ogSlug="credentials"
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'Credentials', path: '/credentials' },
	]}
	schemaNodes={credentialNodes}
>
	<Credentials level={1} />
</Page>
