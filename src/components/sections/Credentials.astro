---
import { CERTIFICATIONS, ACHIEVEMENTS } from '../../data/credentials';

export interface Props {
	level?: 1 | 2;
}

const { level = 2 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<section class="section" id="sec-certs" data-section="certs">
	<Heading>Certifications &amp; Achievements</Heading>

	<h3>Certifications</h3>
	{
		CERTIFICATIONS.map((cert) => (
			<article class="entry">
				<div class="entry__head">
					<h4 class="entry__title">
						{cert.url ? (
							<a href={cert.url} rel="noopener noreferrer" target="_blank">
								{cert.name}
							</a>
						) : (
							cert.name
						)}
					</h4>
					<p class="entry__meta">
						<time datetime={cert.issuedISO}>{cert.issued}</time>
						{cert.expires && <> – <time datetime={cert.expiresISO}>{cert.expires}</time></>}
					</p>
				</div>
				<p class="entry__sub">
					{cert.issuer}
					{cert.credentialId && <> · ID {cert.credentialId}</>}
				</p>
			</article>
		))
	}

	<h3>Achievements</h3>
	{
		ACHIEVEMENTS.map((item) => (
			<article class="entry">
				<h4 class="entry__title">{item.title}</h4>
				<p>{item.detail}</p>
			</article>
		))
	}
</section>
